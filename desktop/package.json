{
  "name": "powershell-config-desktop",
  "version": "8.0.0",
  "private": true,
  "description": "Interface desktop segura para o PowerShell Config",
  "author": "Edilson Vilarinho",
  "type": "module",
  "main": "dist/main/main/main.js",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"tsc -p tsconfig.main.json --watch\" \"wait-on tcp:5173 file:dist/main/main/main.js && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron dist/main/main/main.js\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run typecheck && npm run build:renderer && npm run build:main",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "package:x64": "npm run build && electron-builder --win --x64 --dir --config.directories.output=dist-build/x64",
    "package:arm64": "npm run build && electron-builder --win --arm64 --dir --config.directories.output=dist-build/arm64"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "^4.1.0",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "43.3.0",
    "electron-builder": "26.15.3",
    "jsdom": "^27.1.0",
    "typescript": "7.0.2",
    "vite": "8.2.0",
    "vitest": "^4.1.0",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "com.edilsonvilarinho.powershellconfig",
    "productName": "PowerShell Config",
    "asar": true,
    "compression": "maximum",
    "directories": {
      "output": "dist-build",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "dir",
      "icon": "assets/icon.ico"
    }
  }
}
